# URL backend PHP lúc chạy local (thường đi qua proxy Vite nên để trống cũng được,
# xem cấu hình proxy trong vite.config.js).
VITE_API_BASE_URL=http://localhost:8000

# OAuth Client ID cho "Đăng nhập bằng Google" (không bắt buộc).
# Lấy tại: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
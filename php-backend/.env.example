# Thông tin kết nối MySQL local.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=matkinh
DB_USER=matkinh
DB_PASS=matkinh123

# true = hiện chi tiết lỗi (tiện debug local). Production nhớ đổi thành false.
APP_DEBUG=true

# Domain frontend được phép gọi API, cách nhau bởi dấu phẩy.
# Local (Vite): http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Khoá bí mật ký JWT token đăng nhập. Production nhớ đổi sang giá trị khác.
JWT_SECRET=483e57a3f570e3a6197ce8b66996eeddaa1294d7338da4cada0f2f8562c339c8

# OAuth Client ID cho "Đăng nhập bằng Google" (không bắt buộc).
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Chỉ cho phép email thuộc domain này đăng nhập Google. Để trống = không giới hạn.
ALLOWED_GOOGLE_DOMAIN=

# Lưu ảnh lên Cloudinary thay vì ổ đĩa local (không bắt buộc khi chạy local).
# Để trống/comment -> tự động lưu ảnh vào /uploads. Điền đủ 3 dòng nếu muốn test Cloudinary.
# Lấy tại: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
